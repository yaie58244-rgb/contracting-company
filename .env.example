# Supabase project URL (public, used by the browser client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon public key (safe for the browser; RLS protects the data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only service role key. Never expose it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres URL for migrations and admin tasks only; never expose with NEXT_PUBLIC_.
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
